# Sentinel Pre-Alpha Environment Template
# Copy this file to .env and fill in the values you need.
# Never commit the real .env file.

# ---- Runtime ----
SENTINEL_ENVIRONMENT=development
SENTINEL_CONSERVATIVE_MODE=0
SENTINEL_ENABLE_ACL=1
SENTINEL_ENABLE_FLEET_STARTUP=1

# ---- Sidecar ----
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8765
SENTINEL_SESSION_TOKEN=
SENTINEL_PARENT_PID=
SENTINEL_LOG_DIR=
SENTINEL_DATA_DIR=
SENTINEL_DB_PATH=
SENTINEL_MAX_REQUEST_BYTES=10485760
SENTINEL_ENABLE_API_DOCS=0

# ---- Authentication ----
SENTINEL_JWT_SECRET=
SENTINEL_USER_PASSWORD=

# ---- Model Providers (one or more) ----
SENTINEL_API_KEY_OPENAI=
SENTINEL_API_KEY_OPENROUTER=
SENTINEL_API_KEY_ANTHROPIC=
SENTINEL_OLLAMA_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# ---- Data root ----
# Defaults: development uses <repo>/.local-data, test uses temp, alpha uses %LOCALAPPDATA%\Sentinel
SENTINEL_DATA_DIR=
SENTINEL_LOCAL_MODEL_DIR=
SENTINEL_PLUGIN_DIR=

# ---- Build channel ----
SENTINEL_BUILD_CHANNEL=alpha
SENTINEL_DISABLE_TEST_MODE=1

# ---- Local AI Model (optional) ----
SENTINEL_FORCE_REAL_MODEL=0
SENTINEL_RUN_REAL_E2E=0
SENTINEL_OLLAMA_URL=http://localhost:11434

# ---- Plugins ----
SENTINEL_PLUGIN_DIR=
SENTINEL_PLUGIN_REGISTRY=https://plugins.sentinel.local/registry/v1
SENTINEL_PLUGIN_TIMEOUT_SECONDS=5
SENTINEL_PLUGIN_MEMORY_MB=128
SENTINEL_PLUGIN_CPU_SECONDS=5

# ---- Build / Release ----
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
SOURCE_DATE_EPOCH=
